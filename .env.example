# AI Lab Dashboard — Environment Variables
# Copy this file to .env and fill in your keys.
# All keys are optional at startup; missing keys simply disable that provider.

# --- OpenAI ---
OPENAI_API_KEY=

# --- Anthropic ---
ANTHROPIC_API_KEY=

# --- Google Gemini ---
GEMINI_API_KEY=

# --- OpenRouter ---
OPENROUTER_API_KEY=
# Management key (separate from inference key) — required for balance endpoint
OPENROUTER_MANAGEMENT_KEY=

# --- Tavily ---
TAVILY_API_KEY=
